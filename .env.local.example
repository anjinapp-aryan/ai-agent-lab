# LOCAL — your machine. Copy to .env.local (git-ignored). APP_ENV defaults to "local".
# One provider for BOTH agents: gemini | openrouter | groq | ollama-cloud | openai (or set BASE_URL)
MODEL_PROVIDER=
MODEL_NAME=
API_KEY=
# BASE_URL=

# Tracing: print spans to the console; leave Langfuse keys empty locally.
TRACE_CONSOLE=1
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

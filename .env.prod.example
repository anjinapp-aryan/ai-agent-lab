# PROD — real deployment. Copy to .env.prod ONLY on the deploy target, or better, set these as
# the platform's secret/environment variables (Vercel/Render) and do not use a file at all.
# Select with APP_ENV=prod. Tracing keys are REQUIRED in prod (startup fails without them).
MODEL_PROVIDER=
MODEL_NAME=
API_KEY=
# BASE_URL=

# Langfuse Cloud project "ai-agent-lab-prod" (separate keys from dev)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_OTEL_HOST=https://us.cloud.langfuse.com
